+FPDF_EXPORT int FPDF_CALLCONV FPDF_AddPageFieldsToForm(FPDF_DOCUMENT document,
+                                                       int start_index,
+                                                       int count) {
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc || start_index < 0 || count < 0 ||
+      start_index + count > doc->GetPageCount()) {
+    return -1;
+  }
+  RetainPtr<CPDF_Dictionary> root = doc->GetMutableRoot();
+  if (!root) {
+    return -1;
+  }
+  RetainPtr<CPDF_Dictionary> form = root->GetMutableDictFor("AcroForm");
+  if (!form) {
+    form = doc->NewIndirect<CPDF_Dictionary>();
+    root->SetNewFor<CPDF_Reference>("AcroForm", doc, form->GetObjNum());
+  }
+  RetainPtr<CPDF_Array> fields = form->GetMutableArrayFor("Fields");
+  if (!fields) {
+    fields = form->SetNewFor<CPDF_Array>("Fields");
+  }
+  if (!form->KeyExist("DA")) {
+    form->SetNewFor<CPDF_String>("DA", "/Helv 0 Tf 0 g");
+  }
+
+  // Fields already in the form, and the names in use at the top level.
+  std::set<uint32_t> known;
+  std::set<WideString> names;
+  for (size_t i = 0; i < fields->size(); ++i) {
+    RetainPtr<const CPDF_Dictionary> field = fields->GetDictAt(i);
+    if (!field) {
+      continue;
+    }
+    known.insert(field->GetObjNum());
+    names.insert(field->GetUnicodeTextFor("T"));
+  }
+
+  int added = 0;
+  for (int page = start_index; page < start_index + count; ++page) {
+    RetainPtr<CPDF_Dictionary> page_dict = doc->GetMutablePageDictionary(page);
+    RetainPtr<CPDF_Array> annots =
+        page_dict ? page_dict->GetMutableArrayFor("Annots") : nullptr;
+    if (!annots) {
+      continue;
+    }
+    for (size_t i = 0; i < annots->size(); ++i) {
+      RetainPtr<CPDF_Dictionary> field = annots->GetMutableDictAt(i);
+      if (!field || field->GetNameFor("Subtype") != "Widget") {
+        continue;
+      }
+      // Walk up to the top-level field (bounded, in case of a /Parent cycle).
+      for (int depth = 0; depth < 32; ++depth) {
+        RetainPtr<CPDF_Dictionary> parent = field->GetMutableDictFor("Parent");
+        if (!parent) {
+          break;
+        }
+        field = std::move(parent);
+      }
+      const uint32_t obj_num = field->GetObjNum();
+      if (obj_num == 0 || known.count(obj_num)) {
+        continue;
+      }
+      WideString name = field->GetUnicodeTextFor("T");
+      if (!name.IsEmpty() && names.count(name)) {
+        WideString unique;
+        for (int n = 2;; ++n) {
+          unique = name + WideString::Format(L"_%d", n);
+          if (!names.count(unique)) {
+            break;
+          }
+        }
+        field->SetNewFor<CPDF_String>("T", unique.AsStringView());
+        name = unique;
+      }
+      fields->AppendNew<CPDF_Reference>(doc, obj_num);
+      known.insert(obj_num);
+      names.insert(name);
+      ++added;
+    }
+  }
+  return added;
+}
