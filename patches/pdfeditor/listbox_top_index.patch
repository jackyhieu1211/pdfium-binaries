-void CPDFSDK_Widget::SetTopVisibleIndex(int index) {}
+void CPDFSDK_Widget::SetTopVisibleIndex(int index) {
+  // PdfReader patch: keep the list box scroll position (/TI) so its appearance
+  // shows the selected item. Without it the appearance is drawn from the old
+  // /TI and a newly selected item can be scrolled out of view.
+  CPDF_FormField* field = GetFormField();
+  if (!field || index < 0) {
+    return;
+  }
+  RetainPtr<const CPDF_Dictionary> dict = field->GetFieldDict();
+  if (!dict) {
+    return;
+  }
+  const_cast<CPDF_Dictionary*>(dict.Get())->SetNewFor<CPDF_Number>("TI", index);
+}
 
