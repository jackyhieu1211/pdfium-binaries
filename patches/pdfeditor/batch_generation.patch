+// static
+void CPDF_PageContentGenerator::BeginBatch(CPDF_Document* document) {
+  EndBatch();
+  g_batch = new ContentGenerationBatch();
+  g_batch->doc = document;
+  g_batch->shared_objects = GetObjectsWithMultipleReferences(document);
+  for (int i = 0; i < document->GetPageCount(); ++i) {
+    RetainPtr<CPDF_Dictionary> page_dict = document->GetMutablePageDictionary(i);
+    if (!page_dict) {
+      continue;
+    }
+    g_batch->page_dict_uses[page_dict.Get()]++;
+    auto page = pdfium::MakeRetain<CPDF_Page>(document, std::move(page_dict));
+    if (RetainPtr<CPDF_Dictionary> resources = page->GetMutableResources()) {
+      g_batch->resources_uses[resources.Get()]++;
+    }
+  }
+}
