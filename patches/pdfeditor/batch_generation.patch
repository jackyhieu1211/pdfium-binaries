+// PdfReader patch: batch content generation. GetObjectsWithMultipleReferences()
+// walks the whole document; calling it for every page made generating the
+// content of N pages O(N^2) (minutes for 1000 pages). Between
+// FPDF_BeginContentGeneration() and FPDF_EndContentGeneration() the set is
+// computed once and kept a superset of the truth: objects referenced from a
+// clone made here gain a reference, so they are added. A superset only causes
+// an extra (harmless) clone.
+struct ContentGenerationBatch {
+  UnownedPtr<const CPDF_Document> doc;
+  std::set<uint32_t> shared_objects;
+  // How many pages use each page dictionary / resources dictionary (the
+  // per-page loop in IsPageResourceShared() is O(pages) too).
+  std::map<const CPDF_Dictionary*, int> page_dict_uses;
+  std::map<const CPDF_Dictionary*, int> resources_uses;
+};
+ContentGenerationBatch* g_batch = nullptr;
+
+std::set<uint32_t> SharedObjects(CPDF_Document* doc) {
+  if (g_batch && g_batch->doc.get() == doc) {
+    return g_batch->shared_objects;
+  }
+  return GetObjectsWithMultipleReferences(doc);
+}
+
+void CollectReferences(const CPDF_Object* object,
+                       std::set<uint32_t>* out,
+                       int depth) {
+  if (!object || depth > 32) {
+    return;
+  }
+  if (const CPDF_Reference* ref = object->AsReference()) {
+    out->insert(ref->GetRefObjNum());
+    return;
+  }
+  if (const CPDF_Dictionary* dict = object->AsDictionary()) {
+    CPDF_DictionaryLocker locker(dict);
+    for (const auto& it : locker) {
+      CollectReferences(it.second.Get(), out, depth + 1);
+    }
+    return;
+  }
+  if (const CPDF_Array* array = object->AsArray()) {
+    CPDF_ArrayLocker locker(array);
+    for (const auto& item : locker) {
+      CollectReferences(item.Get(), out, depth + 1);
+    }
+  }
+}
+
+// `clone` was just made from an object of `doc`: what it references now has
+// one more reference.
+void NoteClone(CPDF_Document* doc, const CPDF_Object* clone) {
+  if (g_batch && g_batch->doc.get() == doc) {
+    CollectReferences(clone, &g_batch->shared_objects, 0);
+  }
+}
