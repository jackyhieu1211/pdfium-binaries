+                                                   : nullptr;
+}
+
+// static
+void CPDF_PageContentGenerator::NoteCloneInBatch(CPDF_Document* document,
+                                                 const CPDF_Object* clone) {
+  NoteClone(document, clone);
+}
+
+// static
+void CPDF_PageContentGenerator::EndBatch() {
+  delete g_batch;
+  g_batch = nullptr;
