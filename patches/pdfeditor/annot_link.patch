+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_SetLinkedAnnot(FPDF_ANNOTATION annot,
+                         FPDF_BYTESTRING key,
+                         FPDF_ANNOTATION linked) {
+  CPDF_AnnotContext* pAnnot = CPDFAnnotContextFromFPDFAnnotation(annot);
+  CPDF_AnnotContext* pLinked = CPDFAnnotContextFromFPDFAnnotation(linked);
+  if (!pAnnot || !pLinked || !key || !key[0]) {
+    return false;
+  }
+
+  RetainPtr<CPDF_Dictionary> pDict = pAnnot->GetMutableAnnotDict();
+  RetainPtr<CPDF_Dictionary> pLinkedDict = pLinked->GetMutableAnnotDict();
+  if (!pDict || !pLinkedDict || pDict == pLinkedDict) {
+    return false;
+  }
+
+  IPDF_Page* pPage = pLinked->GetPage();
+  CPDF_Page* pPDFPage = pPage ? pPage->AsPDFPage() : nullptr;
+  if (!pPDFPage) {
+    return false;
+  }
+
+  CPDF_Document* pDoc = pPDFPage->GetDocument();
+  if (pLinkedDict->GetObjNum() == 0) {
+    // Annotations added by FPDFPage_CreateAnnot() are direct objects in the
+    // page's /Annots array: make the linked one indirect so it can be
+    // referenced, and keep a reference to it in /Annots.
+    RetainPtr<CPDF_Array> pAnnots = pPDFPage->GetMutableAnnotsArray();
+    if (!pAnnots) {
+      return false;
+    }
+    std::optional<size_t> index;
+    for (size_t i = 0; i < pAnnots->size(); ++i) {
+      if (pAnnots->GetObjectAt(i).Get() == pLinkedDict.Get()) {
+        index = i;
+        break;
+      }
+    }
+    if (!index.has_value()) {
+      return false;
+    }
+    const uint32_t objnum = pDoc->AddIndirectObject(pLinkedDict);
+    pAnnots->SetNewAt<CPDF_Reference>(index.value(), pDoc, objnum);
+  }
+
+  pDict->SetNewFor<CPDF_Reference>(key, pDoc, pLinkedDict->GetObjNum());
+  return true;
 }
 
