+
+// PdfReader patch: FPDF_AddPageFieldsToForm().
+TEST_F(FPDFPPOEmbedderTest, AddPageFieldsToForm) {
+  ASSERT_TRUE(OpenDocument("text_form.pdf"));
+
+  ScopedFPDFDocument output(FPDF_CreateNewDocument());
+  ASSERT_TRUE(output);
+  // The same form page twice: neither copy is part of the new document's form.
+  ASSERT_TRUE(FPDF_ImportPages(output.get(), document(), nullptr, 0));
+  ASSERT_TRUE(FPDF_ImportPages(output.get(), document(), nullptr, 1));
+  ASSERT_EQ(2, FPDF_GetPageCount(output.get()));
+
+  EXPECT_EQ(-1, FPDF_AddPageFieldsToForm(output.get(), 1, 2));
+  EXPECT_EQ(1, FPDF_AddPageFieldsToForm(output.get(), 0, 1));
+  EXPECT_EQ(1, FPDF_AddPageFieldsToForm(output.get(), 1, 1));
+  // Already part of the form.
+  EXPECT_EQ(0, FPDF_AddPageFieldsToForm(output.get(), 0, 2));
+
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(output.get());
+  RetainPtr<const CPDF_Dictionary> form = doc->GetRoot()->GetDictFor("AcroForm");
+  ASSERT_TRUE(form);
+  RetainPtr<const CPDF_Array> fields = form->GetArrayFor("Fields");
+  ASSERT_TRUE(fields);
+  ASSERT_EQ(2u, fields->size());
+  // The second copy is renamed so that the two stay separate fields.
+  EXPECT_EQ(L"Text Box", fields->GetDictAt(0)->GetUnicodeTextFor("T"));
+  EXPECT_EQ(L"Text Box_2", fields->GetDictAt(1)->GetUnicodeTextFor("T"));
+}
