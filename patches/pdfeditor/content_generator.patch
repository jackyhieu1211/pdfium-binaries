+ByteString CPDF_PageContentGenerator::RealizeSharedResource(
+    RetainPtr<const CPDF_Object> pResource,
+    ByteStringView type) {
+  if (pResource->IsInline()) {
+    RetainPtr<CPDF_Object> clone = pResource->Clone();
+    document_->AddIndirectObject(clone);
+    pResource = std::move(clone);
+  }
+  if (RetainPtr<const CPDF_Dictionary> resources = obj_holder_->GetResources()) {
+    if (RetainPtr<const CPDF_Dictionary> dict = resources->GetDictFor(type)) {
+      CPDF_DictionaryLocker locker(dict);
+      for (const auto& item : locker) {
+        const CPDF_Reference* ref = item.second->AsReference();
+        if (ref && ref->GetRefObjNum() == pResource->GetObjNum()) {
+          return item.first;
+        }
+      }
+    }
+  }
+  return RealizeResource(pResource.Get(), type);
+}
