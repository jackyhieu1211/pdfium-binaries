+FPDF_EXPORT int FPDF_CALLCONV FPDFTextObj_CountChars(FPDF_PAGEOBJECT text_object) {
+  CPDF_TextObject* text_obj = CPDFTextObjectFromFPDFPageObject(text_object);
+  return text_obj ? pdfium::checked_cast<int>(text_obj->CharCount()) : -1;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDFTextObj_GetCharInfo(FPDF_PAGEOBJECT text_object,
+                                                           int index,
+                                                           uint32_t* charcode,
+                                                           float* x0,
+                                                           float* y0,
+                                                           float* x1,
+                                                           float* y1) {
+  CPDF_TextObject* text_obj = CPDFTextObjectFromFPDFPageObject(text_object);
+  if (!text_obj || index < 0 ||
+      static_cast<size_t>(index) >= text_obj->CharCount() || !charcode ||
+      !x0 || !y0 || !x1 || !y1) {
+    return false;
+  }
+  const CPDF_TextObject::Item item =
+      text_obj->GetCharInfo(static_cast<size_t>(index));
+  const CFX_Matrix matrix = text_obj->GetTextMatrix();
+  const CFX_PointF start = matrix.Transform(item.origin_);
+  const float width = text_obj->GetCharWidth(item.char_code_);
+  const CFX_PointF end =
+      matrix.Transform(CFX_PointF(item.origin_.x + width, item.origin_.y));
+  *charcode = item.char_code_;
+  *x0 = start.x;
+  *y0 = start.y;
+  *x1 = end.x;
+  *y1 = end.y;
+  return true;
+}
