+// NUL. Returns the number of bytes needed including the terminator; writes
+// |buffer| only when |buflen| is large enough. 0 on error.
+FPDF_EXPORT unsigned long FPDF_CALLCONV FPDF_GetLayerName(FPDF_DOCUMENT document,
+                                                         int index,
+                                                         FPDF_WCHAR* buffer,
+                                                         unsigned long buflen);
+
+// Whether layer |index| is shown when viewing (default configuration /D with
+// its /ON, /OFF and /BaseState).
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDF_GetLayerVisible(FPDF_DOCUMENT document,
+                                                        int index);
+
+// Shows or hides layer |index| when viewing: updates /ON and /OFF of the
+// default configuration /D (created if missing). Takes effect on the next
+// render and is written when the document is saved.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDF_SetLayerVisible(FPDF_DOCUMENT document,
+                                                        int index,
+                                                        FPDF_BOOL visible);
+
+// Layer tree for a layer panel: /Order of the default configuration /D,
+// flattened into tokens. Token >= 0: layer index (as for FPDF_GetLayerName);
+// -1: start of a nested list (children of the layer just before it, or a
+// labelled group); -2: end of the nested list; <= -3: label of the enclosing
+// group, label number = -3 - token (see FPDF_GetLayerOrderLabel). Writes the
+// tokens into |buffer| when |buflen| is large enough; returns the number of
+// tokens (0 when the file has no /Order).
+FPDF_EXPORT int FPDF_CALLCONV FPDF_GetLayerOrder(FPDF_DOCUMENT document,
+                                                int* buffer,
+                                                int buflen);
+
+// Text of group label |label| of the layer tree, as UTF-16LE with a
+// terminating NUL; returns the number of bytes needed, 0 on error.
+FPDF_EXPORT unsigned long FPDF_CALLCONV
+FPDF_GetLayerOrderLabel(FPDF_DOCUMENT document,
+                        int label,
+                        FPDF_WCHAR* buffer,
+                        unsigned long buflen);
+
+// Whether layer |index| is locked (/Locked of the default configuration):
+// viewers should not let the user show / hide it.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDF_GetLayerLocked(FPDF_DOCUMENT document,
+                                                       int index);
+
+// Copies the optional content marks ("OC", referring to a layer through the
+// page's /Properties) of |source| onto |dest|, so |dest| is shown and hidden
+// with the same layer. Both objects must belong to the same page. Returns
+// the number of marks copied.
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFPageObj_CopyOptionalContent(FPDF_PAGEOBJECT dest, FPDF_PAGEOBJECT source);
