+bool CPDF_PageContentGenerator::WriteColor(fxcrt::ostringstream* buf,
+                                           const CPDF_Color* color,
+                                           bool stroke) {
+  if (!color || color->IsNull()) {
+    return false;
+  }
+  if (color->IsPattern()) {
+    RetainPtr<CPDF_Pattern> pattern = color->GetPattern();
+    if (!pattern) {
+      return false;
+    }
+    // Uncolored tiling patterns also need the underlying color space.
+    CPDF_TilingPattern* tiling = pattern->AsTilingPattern();
+    if (tiling && !tiling->colored()) {
+      return false;
+    }
+    RetainPtr<const CPDF_Object> pattern_obj = pattern->GetPatternObject();
+    if (!pattern_obj) {
+      return false;
+    }
+    ByteString name = RealizeSharedResource(std::move(pattern_obj), "Pattern");
+    *buf << (stroke ? "/Pattern CS /" : "/Pattern cs /") << PDF_NameEncode(name)
+         << (stroke ? " SCN " : " scn ");
+    return true;
+  }
+  const std::vector<float> values = color->GetComponents();
+  RetainPtr<CPDF_ColorSpace> cs = color->GetColorSpace();
+  const CPDF_ColorSpace::Family family =
+      cs ? cs->GetFamily() : CPDF_ColorSpace::Family::kUnknown;
+  if (family == CPDF_ColorSpace::Family::kDeviceGray && values.size() == 1) {
+    WriteFloat(*buf, values[0]) << (stroke ? " G " : " g ");
+    return true;
+  }
+  if (family == CPDF_ColorSpace::Family::kDeviceCMYK && values.size() == 4) {
+    for (float v : values) {
+      WriteFloat(*buf, v) << " ";
+    }
+    *buf << (stroke ? "K " : "k ");
+    return true;
+  }
+  // DeviceRGB, and every other color space (ICC based, Lab, Separation,
+  // DeviceN, Indexed...) converted to RGB.
+  std::optional<FX_RGB_STRUCT<float>> rgb = color->GetRGB();
+  if (!rgb.has_value()) {
+    return false;
+  }
+  WriteFloat(*buf, rgb.value().red) << " ";
+  WriteFloat(*buf, rgb.value().green) << " ";
+  WriteFloat(*buf, rgb.value().blue) << (stroke ? " RG " : " rg ");
+  return true;
+}
+
+// "sh" paints the shading over the current clip path, in the coordinate space
+// given by the object's matrix.
+void CPDF_PageContentGenerator::ProcessShading(
+    fxcrt::ostringstream* buf,
+    CPDF_ShadingObject* pShadingObj) {
+  const CPDF_ShadingPattern* pattern = pShadingObj->pattern();
+  if (!pattern) {
+    return;
+  }
+  RetainPtr<const CPDF_Object> shading = pattern->GetShadingObject();
+  if (!shading) {
+    return;
+  }
+  ByteString name = RealizeSharedResource(std::move(shading), "Shading");
+  ProcessGraphics(buf, pShadingObj);
+  const CFX_Matrix& matrix = pShadingObj->matrix();
+  if (!matrix.IsIdentity()) {
+    WriteMatrix(*buf, matrix) << " cm ";
+  }
+  *buf << "/" << PDF_NameEncode(name) << " sh";
+  EndProcessGraphics(*buf);
+}
